{
    "$schema": "https://opencode.ai/config.json",
    // 默认模型
    "model": "opencode-go/muse-spark-1.3-contributor#xhigh",
    // 默认主 Agent
    "default_agent": "commander",
    // 自动压缩: context=1048576, 45%触发(约471859) -> buffer=576717; 保留最近15%(约157286)
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 157286
        },
        "buffer": 576717
    },
    "agents": {
        "title": {
            "model": "opencode-go/muse-spark-1.3-contributor"
        },
        // 内置维护 Agent 显式指定便宜模型，避免继承 commander 的 gemini 额度被 guard 阻拦
        "compaction": {
            "model": "opencode-go/muse-spark-1.3-contributor"
        },
        "summary": {
            "model": "opencode-go/muse-spark-1.3-contributor"
        },
        "general": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        }
    },
    // vankit config
    "providers": {
        // opencode-go: 显式声明 variants，使 `#xhigh` 等 variant 合法并真正传参 reasoningEffort
        "opencode-go": {
            "models": {
                "muse-spark-1.3-contributor": {
                    "variants": [
                        { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                }
            }
        },
        "vankit-0.06": {
            "name": "Vankit-0.06",
            "env": [
                "VANKIT_0_06_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://sub.vankit.top/v1",
                "apiKey": "{env:VANKIT_0_06_API_KEY}"
            },
            "body": {
                "store": false
            },
            "models": {
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "variants": [
                        {
                            "id": "xhigh"
                        },
                        {
                            "id": "max"
                        }
                    ]
                }
            }
        },
        "vankit-0.15": {
            "name": "Vankit-0.15",
            "env": [
                "VANKIT_0_15_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://sub.vankit.top/v1",
                "apiKey": "{env:VANKIT_0_15_API_KEY}"
            },
            "body": {
                "store": false
            },
            "models": {
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "variants": [
                        {
                            "id": "xhigh"
                        },
                        {
                            "id": "max"
                        }
                    ]
                }
            }
        },
        "vankit-0.25": {
            "name": "Vankit-0.25",
            "env": [
                "VANKIT_0_25_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://sub.vankit.top/v1",
                "apiKey": "{env:VANKIT_0_25_API_KEY}"
            },
            "body": {
                "store": false
            },
            "models": {
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "variants": [
                        {
                            "id": "xhigh"
                        },
                        {
                            "id": "max"
                        }
                    ]
                }
            }
        },
        "vankit-0.55": {
            "name": "Vankit-0.55",
            "env": [
                "VANKIT_0_55_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://sub.vankit.top/v1",
                "apiKey": "{env:VANKIT_0_55_API_KEY}"
            },
            "body": {
                "store": false
            },
            "models": {
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "variants": [
                        {
                            "id": "xhigh"
                        },
                        {
                            "id": "max"
                        }
                    ]
                }
            }
        }
    },
    // provider list.
    "experimental": {
        "policies": [
            {
                "action": "provider.use",
                "resource": "*",
                "effect": "deny"
            },
            {
                "action": "provider.use",
                "resource": "opencode-go",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "vankit-0.06",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "vankit-0.15",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "vankit-0.25",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "vankit-0.55",
                "effect": "allow"
            }
        ]
    },
    // V2 权限
    // 注意：规则是“后匹配的覆盖前匹配的”
    "permissions": [
        // 默认全部允许
        {
            "action": "*", // 允许行为
            "resource": "*", // 允许源
            "effect": "allow" // 处理方式
        },
        // .env 保护
        {
            "action": "read",
            "resource": "*.env",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.env.*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.env.example",
            "effect": "allow"
        },
        // 高危 shell 命令需要确认
        {
            "action": "shell",
            "resource": "rm -rf /",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "rm -rf /*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "rm -rf ~",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "mkfs*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "dd if=* of=/dev/*",
            "effect": "ask"
        },
        // 敏感操作
        {
            "action": "shell",
            "resource": "sudo *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "su *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "chmod -R 777 /*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "chown -R * /*",
            "effect": "ask"
        }
    ],
    // MCP
    "mcp": {
        "servers": {
            // context7 由 @upstash/context7-opencode 插件托管, 不需要key.
            "playwright": {
                "type": "local",
                "command": [
                    "npx",
                    "@playwright/mcp@latest",
                    "--browser",
                    "chromium",
                    "--headless"
                ],
                "disabled": false
            },
            "zotero": {
                "type": "local",
                "command": [
                    "/home/mintusr/.local/bin/zotero-mcp"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 120000,
                    "execution": 120000
                },
                "environment": {
                    "ZOTERO_LOCAL": "true",
                    "ZOTERO_API_KEY": "{env:ZOTERO_API_TOKEN}",
                    "ZOTERO_LIBRARY_ID": "{env:ZOTERO_USERID}",
                    "ZOTERO_LIBRARY_TYPE": "user",
                    "ZOTERO_MCP_TOOLSETS": "libraries,search-admin,pdf-geometry,discovery",
                    "FASTMCP_CHECK_FOR_UPDATES": "off",
                    "ALL_PROXY": "",
                    "all_proxy": ""
                }
            }
        }
    },
    "plugins": [
        "@upstash/context7-opencode",
        {
            "package": "/home/mintusr/.config/opencode/launch-mode",
            "options": {
                "mode": "desktop"
            }
        }
    ]
}
